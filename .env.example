# Copy to .env and fill in HF_TOKEN. Do not commit .env.

# Hugging Face token with access to the gated base model and the persona collection
HF_TOKEN=

# Base model loaded for generation
BASE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Hugging Face collection holding the eRisk personas
HF_COLLECTION=irlab-udc/erisk2026

# cuda or cpu
DEVICE=cuda

# 8-bit loading needs bitsandbytes and a GPU; set false for CPU mode
LOAD_IN_8BIT=true
